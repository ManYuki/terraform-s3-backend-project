# Local .terraform directories (provider plugins and module caches)
**/.terraform/*

# Terraform state files (local state should never be tracked in git)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform variable definition files (may contain secrets)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
